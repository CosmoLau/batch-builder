{
    "name": "batch-builder",
    "version": "0.2.0",
    "title": "i18n:batch-builder.title",
    "description": "批量构建工具",
    "editor": ">=3.8.7",
    "intro": "./README.md",
    "package_version": 2,
    "type": "module",
    "main": "./dist/browser.cjs",
    "engines": {
        "node": "20.15.1"
    },
    "scripts": {
        "dev": "npm run build -- --mode development",
        "build": "vue-tsc -b && vite build"
    },
    "dependencies": {
        "@element-plus/icons-vue": "^2.3.2",
        "element-plus": "^2.14.0",
        "glob": "^13.0.6",
        "open": "^11.0.0",
        "vue": "^3.5.34"
    },
    "devDependencies": {
        "@cocos-fe/vite-plugin-cocos-panel": "^1.0.3",
        "@cocos/creator-types": "^3.8.7",
        "@types/node": "^22.15.21",
        "@vitejs/plugin-vue": "^5.2.2",
        "@vue/tsconfig": "^0.7.0",
        "rollup-plugin-node-externals": "^7.1.3",
        "typescript": "^5.8.2",
        "unplugin-auto-import": "^0.18.6",
        "unplugin-vue-components": "^0.27.5",
        "vite": "^5.4.12",
        "vue-tsc": "^2.1.10"
    },
    "contributions": {
        "menu": [
            {
                "path": "i18n:menu.extension",
                "label": "i18n:batch-builder.title",
                "message": "open"
            }
        ],
        "messages": {
            "open": {
                "methods": [
                    "open"
                ]
            },
            "get-version": {
                "methods": [
                    "getVersion"
                ]
            }
        }
    },
    "panels": {
        "default": {
            "main": "./dist/panel.cjs",
            "icon": "./src/panels/assets/icon_tool.png",
            "size": {
                "min-width": 500,
                "min-height": 500,
                "width": 800,
                "height": 700
            }
        }
    },
    "author": "CosmoLau"
}
